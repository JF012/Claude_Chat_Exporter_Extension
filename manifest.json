{
    "manifest_version": 3,
    "name": "Claude → Obsidian Exporter",
    "version": "1.0",
    "description": "Export your Claude chats to Obsidian-ready Markdown",
    "permissions": [
        "activeTab",
        "scripting"
    ],
    "host_permissions": [
        "https://claude.ai/*"
    ],
    "action": {
        "default_popup": "popup.html",
        "default_icon": "icon.png",
        "default_title": "Export chat to Obsidian"
    },
    "content_scripts": [
        {
            "matches": [
                "https://claude.ai/*"
            ],
            "js": [
                "jszip.min.js",
                "content.js"
            ]
        }
    ]
}